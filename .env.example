# Google Classroom to Sheets Sync - Environment Variables
# Copy this file to .env and fill in your values

# Optional: Google Sheets Spreadsheet ID
# If not set, a new spreadsheet will be created automatically
# Find the ID in the URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
SPREADSHEET_ID=

# Optional: Custom sheet name (tab name)
# SHEET_NAME=Задания и дедлайны